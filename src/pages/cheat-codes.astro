---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getLocalizedCheats } from '../data/cheats';
import { localeFromPath, localizedPath, t } from '../lib/i18n';
import { SITE_URL } from '../lib/seo';

const locale = localeFromPath(Astro.url.pathname);
const lp = (href: string) => localizedPath(locale, href);
const site = Astro.site ?? new URL(SITE_URL);

const title = t(locale, 'pageCheatCodesTitle');
const description = t(locale, 'pageCheatCodesDesc');
const cheatCodes = getLocalizedCheats(locale);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'ItemPage',
    name: title,
    description: description,
    url: `${site.origin}${lp('/cheat-codes')}`,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'HowTo',
    name: t(locale, 'pageCheatCodesTitle'),
    description: t(locale, 'cheatLobbyInstructions'),
    step: [
      {
        '@type': 'HowToStep',
        name: 'Open Admin Panel',
        text: t(locale, 'cheatLobbyInstructions'),
      },
      {
        '@type': 'HowToStep',
        name: 'Enter Cheat Code',
        text: 'Copy and enter one of the cheat codes.',
      },
      {
        '@type': 'HowToStep',
        name: 'Mark as Used',
        text: t(locale, 'markClaimed'),
      },
    ],
  },
];
---

<Layout title={title} description={description} canonicalPath={lp('/cheat-codes')} jsonLd={jsonLd}>
  <Header slot="header" />

  <section class="min-h-screen border-b border-hairline bg-canvas/95 py-8 md:py-14" data-cheats-root>
    <div class="mx-auto max-w-[840px] px-4 md:px-6">

      <!-- Header Row -->
      <div class="flex items-center justify-between gap-4">
        <div class="flex items-center gap-3">
          <a
            href={lp('/')}
            class="inline-flex size-10 items-center justify-center rounded-full border border-hairline bg-canvas-soft text-ink transition-colors hover:bg-canvas-soft-2"
            aria-label={t(locale, 'backToTracker')}
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="19" y1="12" x2="5" y2="12"></line>
              <polyline points="12 19 5 12 12 5"></polyline>
            </svg>
          </a>
          <h1 class="text-2xl font-bold tracking-tight text-ink md:text-3xl">{t(locale, 'cheatCodesPageTitle')}</h1>
        </div>

        <button
          type="button"
          data-reset-cheats
          data-confirm-text={t(locale, 'confirmResetCheats')}
          data-toast-reset={t(locale, 'allCheatsResetToast')}
          class="inline-flex size-10 items-center justify-center rounded-full border border-hairline bg-canvas-soft text-ink transition-colors hover:bg-canvas-soft-2 hover:text-error"
          title={t(locale, 'confirmResetCheats')}
          aria-label={t(locale, 'confirmResetCheats')}
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21.5 2v6h-6"></path>
            <path d="M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"></path>
          </svg>
        </button>
      </div>

      <!-- Subtitle Description -->
      <p class="mt-4 text-sm md:text-base leading-relaxed text-body">
        {t(locale, 'cheatLobbyInstructions')}
      </p>

      <!-- Progress Section -->
      <div class="mt-6">
        <div class="flex items-center justify-between text-xs font-semibold uppercase tracking-wider text-mute">
          <span>{t(locale, 'cheatProgressLabel')}</span>
          <span data-used-progress-text>{t(locale, 'cheatUsedProgress', { used: 0, total: cheatCodes.length })}</span>
        </div>
        <div class="mt-2 h-2.5 w-full overflow-hidden rounded-full bg-hairline">
          <div
            class="h-full rounded-full bg-link transition-all duration-300"
            data-used-progress-bar
            style="width: 0%"
          ></div>
        </div>
      </div>

      <!-- Search & Filters -->
      <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <div class="flex flex-wrap gap-1.5" role="group" aria-label="Filter status">
          {['all', 'unused', 'used'].map((status) => (
            <button
              type="button"
              class="inline-flex h-8 items-center rounded-full border border-hairline-strong bg-canvas px-3.5 text-xs font-medium text-ink transition-colors data-[active=true]:border-ink data-[active=true]:bg-ink data-[active=true]:text-on-primary"
              data-filter-status={status}
              data-active={status === 'all' ? 'true' : 'false'}
            >
              {status === 'all' ? t(locale, 'all') : status === 'unused' ? t(locale, 'missing') : t(locale, 'claimed')}
            </button>
          ))}
        </div>

        <label class="relative block w-full sm:w-64">
          <span class="sr-only">{t(locale, 'searchCheatsPlaceholder')}</span>
          <input
            type="search"
            placeholder={t(locale, 'searchCheatsPlaceholder')}
            data-search-input
            class="h-9 w-full rounded-md border border-hairline-strong bg-canvas px-3 text-xs text-ink outline-none placeholder:text-mute focus:border-ink"
          />
        </label>
      </div>

      <!-- Toast Alert -->
      <div
        data-toast
        class="fixed bottom-6 right-6 z-50 hidden rounded-md bg-ink px-4 py-2.5 text-xs font-medium text-on-primary shadow-card-lg transition-all"
        aria-live="polite"
      >
        {t(locale, 'codeCopied')}
      </div>

      <!-- Cheat Codes List -->
      <div class="mt-6 space-y-3" data-cheats-list data-total-count={cheatCodes.length}>
        {cheatCodes.map((item) => (
          <div
            class="cheat-row group relative flex items-center justify-between gap-3 rounded-xl border border-hairline bg-canvas p-4 shadow-card transition-all duration-200 hover:border-hairline-strong data-[hidden=true]:hidden data-[used=true]:bg-canvas-soft/80"
            data-id={item.id}
            data-code={item.code.toLowerCase()}
            data-title={item.title.toLowerCase()}
            data-category={item.category}
            data-used="false"
            data-hidden="false"
          >
            {/* Left side: Icon + Details */}
            <div class="flex items-center gap-3.5 min-w-0 flex-1">
              {/* Category Icon */}
              <div class="relative flex size-10 shrink-0 items-center justify-center rounded-lg bg-canvas-soft-2 text-ink shadow-sm overflow-hidden">
                {/* Glow backdrop */}
                <div
                  class="absolute inset-0 opacity-40 blur-sm animate-[icon-glow-pulse_3s_ease-in-out_infinite]"
                  style={`background: ${
                    item.iconType === 'sprite'
                      ? '#a78bfa'
                      : item.iconType === 'xp'
                      ? '#facc15'
                      : item.iconType === 'dust'
                      ? '#f59e0b'
                      : item.iconType === 'item'
                      ? '#ef4444'
                      : item.iconType === 'screen'
                      ? '#ec4899'
                      : '#38bdf8'
                  }`}
                ></div>

                {item.iconType === 'sprite' && (
                  /* Space Invader Pixel Sprite - Float Animation */
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="#a78bfa" aria-hidden="true" class="relative z-10 animate-[icon-float_2.8s_ease-in-out_infinite] group-hover:scale-110 transition-transform">
                    <path d="M6 2h12v2H6V2zm-2 4h16v2H4V6zm-2 4h20v2H2v-2zm0 4h6v2H2v-2zm14 0h6v2h-6v-2zm-10 4h2v2H6v-2zm10 0h2v2h-2v-2zm-8 2h6v2H8v-2z"/>
                  </svg>
                )}
                {item.iconType === 'xp' && (
                  /* Star - Scale Pulse Animation */
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="#eab308" aria-hidden="true" class="relative z-10 animate-[icon-pulse-scale_2.4s_ease-in-out_infinite] group-hover:rotate-12 transition-transform">
                    <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                  </svg>
                )}
                {item.iconType === 'dust' && (
                  /* Sparkles - Float + Sparkle Animation */
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="#f59e0b" aria-hidden="true" class="relative z-10 animate-[icon-float_3.2s_ease-in-out_infinite] group-hover:scale-110 transition-transform">
                    <path d="M12 2l2.4 7.2H22l-6 4.4 2.3 7.2L12 16.8 5.7 20.8 8 13.6 2 9.2h7.6L12 2z" />
                  </svg>
                )}
                {item.iconType === 'item' && (
                  /* Gift Box - Wiggle Animation */
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#ef4444" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="relative z-10 group-hover:animate-[icon-wiggle_0.5s_ease-in-out]">
                    <polyline points="20 12 20 22 4 22 4 12"></polyline>
                    <rect x="2" y="7" width="20" height="5"></rect>
                    <line x1="12" y1="22" x2="12" y2="7"></line>
                    <path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"></path>
                    <path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"></path>
                  </svg>
                )}
                {item.iconType === 'screen' && (
                  /* Loading Screen Frame - Pulse Animation */
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#ec4899" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="relative z-10 animate-[icon-pulse-scale_3s_ease-in-out_infinite] group-hover:scale-105 transition-transform">
                    <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                    <circle cx="8.5" cy="8.5" r="1.5"></circle>
                    <polyline points="21 15 16 10 5 21"></polyline>
                  </svg>
                )}
                {item.iconType === 'brick' && (
                  /* Tetrimino Bricks - Wiggle Animation */
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="#38bdf8" aria-hidden="true" class="relative z-10 group-hover:animate-[icon-wiggle_0.4s_ease-in-out]">
                    <rect x="3" y="3" width="8" height="8" rx="1"></rect>
                    <rect x="13" y="3" width="8" height="8" rx="1"></rect>
                    <rect x="3" y="13" width="8" height="8" rx="1"></rect>
                    <rect x="13" y="13" width="8" height="8" rx="1"></rect>
                  </svg>
                )}
              </div>

              {/* Text Info */}
              <div class="min-w-0 flex-1">
                <h3 class="text-sm font-semibold tracking-tight text-ink truncate">
                  {item.title}
                  {item.note && <span class="ml-1 text-xs font-normal text-mute">{item.note}</span>}
                </h3>
                <div class="mt-0.5 flex flex-wrap items-center gap-2">
                  <code
                    class="font-mono text-sm font-bold tracking-wide"
                    style={`color: ${item.color}`}
                  >
                    {item.code}
                  </code>
                  {item.dustCost && (
                    <span class="rounded bg-canvas-soft-2 px-1.5 py-0.5 font-mono text-[10px] font-semibold text-mute">
                      {t(locale, 'dustAmount', { n: item.dustCost })}
                    </span>
                  )}
                </div>
                {item.combo && (
                  <div class="mt-1.5 flex items-center gap-1.5">
                    <span class="text-[10px] uppercase font-mono text-mute tracking-wider">Combo:</span>
                    <span class="inline-flex items-center rounded border border-hairline/80 bg-canvas-soft-2 px-2 py-0.5 font-mono text-xs font-semibold text-ink">
                      {item.combo}
                    </span>
                  </div>
                )}
              </div>
            </div>

            {/* Right side: Actions (Copy + Circle Checkmark) */}
            <div class="flex items-center gap-2 shrink-0">
              {/* Copy Icon Button */}
              <button
                type="button"
                data-copy-btn={item.code}
                class="inline-flex size-9 items-center justify-center rounded-lg border border-hairline bg-canvas text-mute transition-colors hover:border-ink hover:text-ink active:scale-95"
                title={t(locale, 'copyCode')}
                aria-label={`${t(locale, 'copyCode')} ${item.code}`}
              >
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                  <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                </svg>
              </button>

              {/* Circle Checkmark Button */}
              <button
                type="button"
                data-claim-circle={item.id}
                class="claim-circle inline-flex size-9 items-center justify-center rounded-full border-2 border-hairline-strong text-transparent transition-all hover:border-ink data-[used=true]:border-link data-[used=true]:bg-link data-[used=true]:text-on-primary"
                title={t(locale, 'markClaimed')}
                aria-label={`${t(locale, 'markClaimed')} ${item.title}`}
              >
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
              </button>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</Layout>

<script>
  import { getClaimedCheats, saveClaimedCheats } from '../data/cheats';

  const root = document.querySelector<HTMLElement>('[data-cheats-root]');
  if (root) {
    let claimedSet = new Set(getClaimedCheats());
    let currentFilter = 'all';
    let searchQuery = '';

    const toast = root.querySelector<HTMLElement>('[data-toast]');
    function showToast(msg: string) {
      if (!toast) return;
      toast.textContent = msg;
      toast.classList.remove('hidden');
      setTimeout(() => toast.classList.add('hidden'), 2000);
    }

    // Filter status handlers
    root.querySelectorAll('[data-filter-status]').forEach((btn) => {
      btn.addEventListener('click', () => {
        currentFilter = btn.getAttribute('data-filter-status') || 'all';
        root.querySelectorAll('[data-filter-status]').forEach((b) => {
          b.setAttribute('data-active', b === btn ? 'true' : 'false');
        });
        render();
      });
    });

    // Search query handler
    root.querySelector('[data-search-input]')?.addEventListener('input', (e) => {
      searchQuery = (e.target as HTMLInputElement).value.trim().toLowerCase();
      render();
    });

    // Copy code button handler
    root.querySelectorAll<HTMLElement>('[data-copy-btn]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const code = btn.getAttribute('data-copy-btn');
        if (!code) return;
        try {
          await navigator.clipboard.writeText(code);
          showToast(`Copied "${code}" to clipboard!`);
        } catch (_) {
          showToast(`Code: ${code}`);
        }
      });
    });

    // Claim circle handler
    root.querySelectorAll<HTMLElement>('[data-claim-circle]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const id = btn.getAttribute('data-claim-circle');
        if (!id) return;

        if (claimedSet.has(id)) {
          claimedSet.delete(id);
        } else {
          claimedSet.add(id);
        }
        saveClaimedCheats(Array.from(claimedSet));
        render();
      });
    });

    // Reset button handler
    const resetBtn = root.querySelector<HTMLButtonElement>('[data-reset-cheats]');
    resetBtn?.addEventListener('click', () => {
      const confirmMsg = resetBtn.getAttribute('data-confirm-text') || 'Reset all marked cheat codes?';
      const toastMsg = resetBtn.getAttribute('data-toast-reset') || 'All cheat codes reset.';
      if (!window.confirm(confirmMsg)) return;
      claimedSet.clear();
      saveClaimedCheats([]);
      render();
      showToast(toastMsg);
    });

    function render() {
      const listEl = root!.querySelector('[data-cheats-list]');
      const total = Number(listEl?.getAttribute('data-total-count') || 0);
      const usedCount = claimedSet.size;

      // Update progress bar & text
      const progressText = root!.querySelector('[data-used-progress-text]');
      const progressBar = root!.querySelector<HTMLElement>('[data-used-progress-bar]');

      if (progressText) {
        progressText.textContent = `${usedCount} / ${total} used`;
      }
      if (progressBar) {
        progressBar.style.width = `${total ? (usedCount / total) * 100 : 0}%`;
      }

      // Filter each card
      root!.querySelectorAll<HTMLElement>('.cheat-row').forEach((card) => {
        const id = card.getAttribute('data-id') || '';
        const code = card.getAttribute('data-code') || '';
        const title = card.getAttribute('data-title') || '';
        const isUsed = claimedSet.has(id);

        card.setAttribute('data-used', isUsed ? 'true' : 'false');
        const circle = card.querySelector('[data-claim-circle]');
        if (circle) circle.setAttribute('data-used', isUsed ? 'true' : 'false');

        const statusMatch =
          currentFilter === 'all' ||
          (currentFilter === 'used' && isUsed) ||
          (currentFilter === 'unused' && !isUsed);

        const searchMatch = !searchQuery || title.includes(searchQuery) || code.includes(searchQuery);

        const show = statusMatch && searchMatch;
        card.setAttribute('data-hidden', show ? 'false' : 'true');
      });
    }

    render();
  }
</script>
