---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ErrorPage from '../components/ErrorPage.astro';
import { localeFromPath, t } from '../lib/i18n';

Astro.response.status = 404;
const locale = localeFromPath(Astro.url.pathname);
---

<Layout
  title={t(locale, 'pageNotFoundTitle')}
  description={t(locale, 'pageNotFoundDesc')}
  canonicalPath="/404"
  noIndex={true}
>
  <Header slot="header" />
  <ErrorPage
    code="404"
    eyebrow={t(locale, 'notFound')}
    heading={t(locale, 'notFoundHeading')}
    intro={t(locale, 'notFoundIntro')}
  />
  <Footer slot="footer" />
</Layout>
