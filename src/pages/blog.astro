---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { getBlogPosts } from '../data/blogPosts';
import { breadcrumbJsonLd, SITE_NAME, SITE_URL } from '../lib/seo';
import { localeFromPath, localizedPath, localeMeta, t } from '../lib/i18n';

const locale = localeFromPath(Astro.url.pathname);
const lp = (href: string) => localizedPath(locale, href);
const posts = getBlogPosts(locale);
const dateLocale = localeMeta[locale].dateLocale;

const jsonLd = [
  breadcrumbJsonLd([{ name: 'Blog', path: '/blog' }]),
  {
    '@context': 'https://schema.org',
    '@type': 'Blog',
    name: `${SITE_NAME} Blog`,
    url: `${SITE_URL}/blog`,
    description: t(locale, 'blogIntro'),
    isPartOf: {
      '@type': 'WebSite',
      name: SITE_NAME,
      url: SITE_URL,
    },
  },
  ...posts.map((post) => ({
    '@context': 'https://schema.org',
    '@type': 'BlogPosting' as const,
    headline: post.title,
    url: `${SITE_URL}/blog/${post.slug}`,
    datePublished: post.datePublished,
    dateModified: post.dateModified,
    author: { '@type': 'Organization' as const, name: SITE_NAME },
  })),
];
---

<Layout
  title={t(locale, 'blogPageTitle')}
  description={t(locale, 'blogIntro')}
  canonicalPath={lp('/blog')}
  jsonLd={jsonLd}
>
  <Header slot="header" />
  <section class="border-b border-hairline bg-canvas">
    <div class="mx-auto max-w-[800px] px-4 py-16 md:px-6 md:py-24">
      <Breadcrumb locale={locale} items={[{ label: t(locale, 'blogPageTitle') }]} />
      <p class="text-caption-mono text-mute">{t(locale, 'blogEyebrow')}</p>
      <h1 class="mt-3 text-display-lg text-ink">{t(locale, 'blogTitle')}</h1>
      <p class="mt-4 text-lg text-body">
        {t(locale, 'blogIntro')}
      </p>
    </div>
  </section>

  <section class="bg-canvas">
    <div class="mx-auto max-w-[800px] px-4 py-10 md:px-6 md:py-16">
      <ul class="space-y-8">
        {posts.map((post) => (
          <li class="rounded-md border border-hairline bg-canvas-soft p-6 shadow-card">
            <p class="text-caption-mono text-mute text-xs">
              <time datetime={post.datePublished}>
                {new Date(post.datePublished + 'T12:00:00Z').toLocaleDateString(dateLocale, { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })}
              </time>
              {post.dateModified !== post.datePublished && (
                <span>
                  {' '}· {t(locale, 'blogUpdated')}{' '}
                  <time datetime={post.dateModified}>
                    {new Date(post.dateModified + 'T12:00:00Z').toLocaleDateString(dateLocale, { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })}
                  </time>
                </span>
              )}
            </p>
            <h2 class="mt-2 text-display-sm text-ink">
              <a href={lp(`/blog/${post.slug}`)} class="hover:underline">{post.title}</a>
            </h2>
            <p class="mt-2 text-sm leading-6 text-body">{post.excerpt}</p>
            <p class="mt-3">
              <a href={lp(`/blog/${post.slug}`)} class="text-sm font-medium text-link hover:underline">
                {t(locale, 'blogReadMore')}
              </a>
            </p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <Footer slot="footer" />
</Layout>