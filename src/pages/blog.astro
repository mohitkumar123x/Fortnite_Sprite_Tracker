---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import LegalDoc from '../components/LegalDoc.astro';
import { breadcrumbJsonLd, SITE_NAME, SITE_URL } from '../lib/seo';
import { localeFromPath, localizedPath, t } from '../lib/i18n';

const locale = localeFromPath(Astro.url.pathname);
const lp = (href: string) => localizedPath(locale, href);

const jsonLd = [
  breadcrumbJsonLd([{ name: 'Blog', path: '/blog' }]),
  {
    '@context': 'https://schema.org',
    '@type': 'Blog',
    name: `${SITE_NAME} Blog`,
    url: `${SITE_URL}/blog`,
    description: t(locale, 'blogIntro'),
    isPartOf: {
      '@type': 'WebSite',
      name: SITE_NAME,
      url: SITE_URL,
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: t(locale, 'blogPost1Title'),
    url: `${SITE_URL}/blog#track-collection`,
    datePublished: '2026-08-25',
    author: { '@type': 'Organization', name: SITE_NAME },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: t(locale, 'blogPost2Title'),
    url: `${SITE_URL}/blog#hunt-mode`,
    datePublished: '2026-08-25',
    author: { '@type': 'Organization', name: SITE_NAME },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: t(locale, 'blogPost3Title'),
    url: `${SITE_URL}/blog#compare-lockers`,
    datePublished: '2026-08-25',
    author: { '@type': 'Organization', name: SITE_NAME },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: t(locale, 'blogPost4Title'),
    url: `${SITE_URL}/blog#cheat-codes`,
    datePublished: '2026-08-25',
    author: { '@type': 'Organization', name: SITE_NAME },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: t(locale, 'blogPost5Title'),
    url: `${SITE_URL}/blog#season-archives`,
    datePublished: '2026-08-25',
    author: { '@type': 'Organization', name: SITE_NAME },
  },
];
---

<Layout
  title={`${t(locale, 'blogPageTitle')} — ${SITE_NAME}`}
  description={t(locale, 'blogIntro')}
  canonicalPath={lp('/blog')}
  jsonLd={jsonLd}
>
  <Header slot="header" />
  <div class="mx-auto max-w-[800px] px-4 pt-8 md:px-6 md:pt-12">
    <Breadcrumb locale={locale} items={[{ label: t(locale, 'bcBlog') }]} />
    <div class="flex justify-end">
      <button
        type="button"
        data-print-btn
        class="inline-flex items-center gap-2 rounded-full border border-hairline bg-canvas-soft px-4 py-2 text-sm font-medium text-ink transition-colors hover:bg-canvas-soft-2"
        title={t(locale, 'printPage')}
        aria-label={t(locale, 'printPage')}
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="6 9 6 2 18 2 18 9"></polyline>
          <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path>
          <rect x="6" y="14" width="12" height="8"></rect>
        </svg>
        {t(locale, 'printPage')}
      </button>
    </div>
  </div>
  <LegalDoc
    eyebrow={t(locale, 'blogEyebrow')}
    heading={t(locale, 'blogTitle')}
    intro={t(locale, 'blogIntro')}
    updated="2026-08-25"
  >
    <h2 id="track-collection">{t(locale, 'blogPost1Title')}</h2>
    <p>{t(locale, 'blogPost1Body')}</p>
    <p>
      <a href={lp('/')}>{t(locale, 'openChecklist')}</a>
    </p>

    <h2 id="hunt-mode">{t(locale, 'blogPost2Title')}</h2>
    <p>{t(locale, 'blogPost2Body')}</p>
    <p>
      <a href={lp('/#tracker')}>{t(locale, 'openTracker')}</a>
    </p>

    <h2 id="compare-lockers">{t(locale, 'blogPost3Title')}</h2>
    <p>{t(locale, 'blogPost3Body')}</p>
    <p>
      <a href={lp('/compare')}>{t(locale, 'compareLockers')}</a>
    </p>

    <h2 id="cheat-codes">{t(locale, 'blogPost4Title')}</h2>
    <p>{t(locale, 'blogPost4Body')}</p>
    <p>
      <a href={lp('/cheat-codes')}>{t(locale, 'navCheatCodes')}</a>
    </p>

    <h2 id="season-archives">{t(locale, 'blogPost5Title')}</h2>
    <p>{t(locale, 'blogPost5Body')}</p>
    <p>
      <a href={lp('/seasons')}>{t(locale, 'navSeasons')}</a>
    </p>
  </LegalDoc>
  <Footer slot="footer" />
</Layout>

<script is:inline>
  document.querySelectorAll('[data-print-btn]').forEach(function (btn) {
    btn.addEventListener('click', function () { window.print(); });
  });
</script>
