---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import SpriteCard from '../../components/SpriteCard.astro';
import { allSeasons as rawSeasons, allSprites, getSeasonById } from '../../lib/catalog';
import { localeFromPath, localizedPath, t } from '../../lib/i18n';
import { localizeSeason, localizeSeasons } from '../../lib/localizeData';

const locale = localeFromPath(Astro.url.pathname);
const lp = (href: string) => localizedPath(locale, href);
const seasons = localizeSeasons(rawSeasons, locale);
const bySeason = seasons.map((season) => ({
  season,
  sprites: allSprites.filter((s) => s.seasonId === season.id),
}));
---

<Layout
  title={t(locale, 'pageSpritesTitle')}
  description={t(locale, 'pageSpritesDesc')}
  canonicalPath={lp('/sprites')}
>
  <Header slot="header" />
  <section class="border-b border-hairline bg-canvas">
    <div class="mx-auto max-w-[1400px] px-4 py-16 md:px-6 md:py-24">
      <Breadcrumb locale={locale} items={[{ label: t(locale, 'bcSprites') }]} />
      <div class="flex items-start justify-between gap-4">
        <div>
          <p class="text-caption-mono text-mute">{t(locale, 'spritesEyebrow')}</p>
          <h1 class="mt-3 text-display-lg text-ink">{t(locale, 'spritesTitle')}</h1>
          <p class="mt-3 max-w-2xl text-lg text-body">
            {t(locale, 'spritesIntro')}
          </p>
        </div>
        <button
          type="button"
          data-print-btn
          class="mt-2 inline-flex shrink-0 items-center gap-2 rounded-full border border-hairline bg-canvas-soft px-4 py-2 text-sm font-medium text-ink transition-colors hover:bg-canvas-soft-2 no-print"
          title={t(locale, 'printSprites')}
          aria-label={t(locale, 'printSprites')}
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="6 9 6 2 18 2 18 9"></polyline>
            <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path>
            <rect x="6" y="14" width="12" height="8"></rect>
          </svg>
          {t(locale, 'printSprites')}
        </button>
      </div>

      {
        bySeason.map(({ season, sprites }) => (
          <div class="mt-14">
            <div class="flex flex-wrap items-end justify-between gap-3">
              <div>
                <h2 class="text-display-md text-ink">{season.label}</h2>
                <p class="mt-1 text-sm text-mute">{season.patchNote}</p>
              </div>
              <a
                href={season.isCurrent ? lp('/#tracker') : lp(`/seasons/${season.slug}`)}
                class="text-sm font-medium"
              >
                {t(locale, 'openChecklist')}
              </a>
            </div>
            <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3 sprite-print-grid">
              {sprites.map((sprite) => (
                <SpriteCard
                  id={sprite.id}
                  name={sprite.name}
                  rarity={sprite.rarity}
                  seasonLabel={getSeasonById(sprite.seasonId)?.shortLabel ?? sprite.seasonId}
                  variantCount={sprite.variants.length}
                  ability={sprite.ability}
                  href={lp(`/sprites/${sprite.id}`)}
                />
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </section>
  <Footer slot="footer" />
</Layout>

<style is:inline>
  @media print {
    .sprite-print-grid {
      display: grid !important;
      grid-template-columns: repeat(2, 1fr) !important;
      gap: 8px !important;
    }

    .sprite-print-grid a {
      break-inside: avoid;
      border: 1px solid #ccc !important;
      padding: 8px !important;
      box-shadow: none !important;
      text-decoration: none !important;
      color: black !important;
      background: white !important;
    }

    .sprite-print-grid a::after {
      content: none !important;
    }

    .sprite-print-grid h3 {
      font-size: 14px !important;
    }

    .sprite-print-grid p {
      font-size: 11px !important;
    }

    .sprite-print-grid svg {
      display: none !important;
    }
  }
</style>

<script is:inline>
  document.querySelectorAll('[data-print-btn]').forEach(function (btn) {
    btn.addEventListener('click', function () { window.print(); });
  });
</script>
