---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import SpriteArt from '../../components/SpriteArt.astro';
import { allSprites, getSeasonById } from '../../lib/catalog';

export function getStaticPaths() {
  return allSprites.map((sprite) => ({
    params: { id: sprite.id },
  }));
}

const { id } = Astro.params;
const sprite = allSprites.find((s) => s.id === id);
if (!sprite) {
  return Astro.redirect('/sprites');
}
const season = getSeasonById(sprite.seasonId);
---

<Layout
  title={`${sprite.name} | Fortnite Sprite Tracker List`}
  description={`Track ${sprite.name} in the Fortnite Sprite Tracker checklist. ${sprite.rarity} rarity — ability, variants, and where to find it. Mark Owned on the Fortnite Sprite Tracker chart.`}
  canonicalPath={`/sprites/${sprite.id}`}
>
  <Header slot="header" />
  <article class="border-b border-hairline bg-canvas">
    <div class="mx-auto max-w-[900px] px-4 py-16 md:px-6 md:py-24">
      <a href="/sprites" class="text-sm font-medium">← All sprites</a>
      <div class="mt-8 flex items-start gap-5">
        <SpriteArt id={sprite.id} name={sprite.name} size="lg" />
        <div>
          <p class="text-caption-mono text-mute">
            {season?.shortLabel ?? sprite.seasonId} · <span class="capitalize">{sprite.rarity}</span>
          </p>
          <h1 class="mt-2 text-display-lg text-ink">{sprite.name}.</h1>
        </div>
      </div>

      <section class="mt-12">
        <h2 class="text-display-sm text-ink">Ability</h2>
        <p class="mt-3 text-base leading-7 text-body">{sprite.ability}</p>
      </section>

      {
        sprite.levelNotes && (
          <section class="mt-10">
            <h2 class="text-display-sm text-ink">Leveling notes</h2>
            <p class="mt-3 text-base leading-7 text-body">{sprite.levelNotes}</p>
          </section>
        )
      }

      <section class="mt-10">
        <h2 class="text-display-sm text-ink">Where to find</h2>
        <p class="mt-3 text-base leading-7 text-body">{sprite.findNotes}</p>
      </section>

      <section class="mt-10">
        <h2 class="text-display-sm text-ink">Variants</h2>
        <ul class="mt-4 divide-y divide-hairline rounded-md border border-hairline bg-canvas-soft">
          {
            sprite.variants.map((variant) => (
              <li class="flex flex-wrap items-center justify-between gap-3 px-4 py-3 text-sm">
                <div>
                  <p class="font-medium text-ink">{variant.label}</p>
                  {variant.bonus && <p class="text-body">{variant.bonus}</p>}
                </div>
                {typeof variant.dustCost === 'number' && (
                  <p class="text-caption-mono text-mute">{variant.dustCost} dust</p>
                )}
              </li>
            ))
          }
        </ul>
      </section>

      <div class="mt-12 flex flex-wrap gap-3">
        <a
          href={season?.isCurrent ? '/#tracker' : `/seasons/${season?.slug}`}
          class="inline-flex h-12 items-center rounded-pill bg-ink px-4 text-base font-medium text-on-primary no-underline hover:text-on-primary"
        >
          Mark on tracker
        </a>
        <a
          href="/compare"
          class="inline-flex h-12 items-center rounded-pill border border-hairline bg-canvas px-4 text-base font-medium text-ink no-underline hover:text-ink"
        >
          Compare lockers
        </a>
      </div>
    </div>
  </article>
  <Footer slot="footer" />
</Layout>
