---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import SpriteArt from '../../components/SpriteArt.astro';
import { allSprites, getSeasonById } from '../../lib/catalog';
import { localeFromPath, localizedPath, t } from '../../lib/i18n';
import { localizeBonus, localizeRarity, localizeSpriteAbility, localizeVariantLabel } from '../../lib/localizeData';

export function getStaticPaths() {
  return allSprites.map((sprite) => ({
    params: { id: sprite.id },
  }));
}

const { id } = Astro.params;
const locale = localeFromPath(Astro.url.pathname);
const lp = (href: string) => localizedPath(locale, href);
const sprite = allSprites.find((s) => s.id === id);
if (!sprite) {
  return Astro.redirect(lp('/sprites'));
}
const season = getSeasonById(sprite.seasonId);
const localizedRarity = localizeRarity(sprite.rarity, locale);
const localizedAbility = localizeSpriteAbility(sprite.id, sprite.ability, locale);
---

<Layout
  title={t(locale, 'pageSpriteDetailTitle', { name: sprite.name })}
  description={t(locale, 'pageSpriteDetailDesc', { name: sprite.name, rarity: localizedRarity })}
  canonicalPath={lp(`/sprites/${sprite.id}`)}
>
  <Header slot="header" />
  <article class="border-b border-hairline bg-canvas">
    <div class="mx-auto max-w-[900px] px-4 py-16 md:px-6 md:py-24">
      <Breadcrumb locale={locale} items={[
        { label: t(locale, 'bcSprites'), href: lp('/sprites') },
        { label: sprite.name },
      ]} />
      <a href={lp('/sprites')} class="text-sm font-medium">{t(locale, 'backSprites')}</a>
      <div class="mt-8 flex items-start gap-5">
        <SpriteArt id={sprite.id} name={sprite.name} rarity={sprite.rarity} size="lg" />
        <div>
          <p class="text-caption-mono text-mute">
            {season?.shortLabel ?? sprite.seasonId} · <span class="capitalize">{localizedRarity}</span>
            {sprite.available === false && (
              <span class="ml-2 inline-flex items-center rounded-full bg-error-soft px-2 py-0.5 text-xs font-semibold text-error">{t(locale, 'unreleased')}</span>
            )}
          </p>
          <h1 class="mt-2 text-display-lg text-ink">{sprite.name}.</h1>
        </div>
      </div>

      <section class="mt-12">
        <h2 class="text-display-sm text-ink">{t(locale, 'ability')}</h2>
        <p class="mt-3 text-base leading-7 text-body">{localizedAbility}</p>
      </section>

      {
        sprite.levelNotes && (
          <section class="mt-10">
            <h2 class="text-display-sm text-ink">{t(locale, 'leveling')}</h2>
            <p class="mt-3 text-base leading-7 text-body">{sprite.levelNotes}</p>
          </section>
        )
      }

      <section class="mt-10">
        <h2 class="text-display-sm text-ink">{t(locale, 'whereFind')}</h2>
        <p class="mt-3 text-base leading-7 text-body">{sprite.findNotes}</p>
      </section>

      {(sprite.summonCost || sprite.dropChance || sprite.location) && (
        <section class="mt-10">
          <h2 class="text-display-sm text-ink">{t(locale, 'spriteStats')}</h2>
          <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-3">
            {typeof sprite.summonCost === 'number' && (
              <div class="rounded-md border border-hairline bg-canvas-soft px-4 py-3">
                <p class="text-caption-mono text-mute text-xs uppercase">{t(locale, 'summonCost')}</p>
                <p class="mt-1 text-lg font-semibold text-ink">{sprite.summonCost.toLocaleString()} Dust</p>
              </div>
            )}
            {typeof sprite.dropChance === 'number' && (
              <div class="rounded-md border border-hairline bg-canvas-soft px-4 py-3">
                <p class="text-caption-mono text-mute text-xs uppercase">{t(locale, 'dropChance')}</p>
                <p class="mt-1 text-lg font-semibold text-ink">{sprite.dropChance < 0.01 ? '<0.01' : sprite.dropChance}%</p>
              </div>
            )}
            {sprite.location && (
              <div class="rounded-md border border-hairline bg-canvas-soft px-4 py-3">
                <p class="text-caption-mono text-mute text-xs uppercase">{t(locale, 'location')}</p>
                <p class="mt-1 text-sm font-medium text-ink">{sprite.location}</p>
              </div>
            )}
          </div>
        </section>
      )}

      <section class="mt-10">
        <h2 class="text-display-sm text-ink">{t(locale, 'variants')}</h2>
        <ul class="mt-4 divide-y divide-hairline rounded-md border border-hairline bg-canvas-soft">
          {
            sprite.variants.map((variant) => (
              <li class="flex flex-wrap items-center justify-between gap-3 px-4 py-3 text-sm">
                <div>
                  <p class="font-medium text-ink">{localizeVariantLabel(variant.label, locale)}</p>
                  {variant.bonus && <p class="text-body">{localizeBonus(variant.bonus, locale)}</p>}
                </div>
                {typeof variant.dustCost === 'number' && (
                  <p class="text-caption-mono text-mute">{t(locale, 'dustAmount', { n: variant.dustCost })}</p>
                )}
              </li>
            ))
          }
        </ul>
      </section>

      <div class="mt-12 flex flex-wrap gap-3">
        <a
          href={season?.isCurrent ? lp('/#tracker') : lp(`/seasons/${season?.slug}`)}
          class="inline-flex h-12 items-center rounded-pill bg-ink px-4 text-base font-medium text-on-primary no-underline hover:text-on-primary"
        >
          {t(locale, 'markOnTracker')}
        </a>
        <a
          href={lp('/compare')}
          class="inline-flex h-12 items-center rounded-pill border border-hairline bg-canvas px-4 text-base font-medium text-ink no-underline hover:text-ink"
        >
          {t(locale, 'compareLockers')}
        </a>
      </div>
    </div>
  </article>
  <Footer slot="footer" />
</Layout>
