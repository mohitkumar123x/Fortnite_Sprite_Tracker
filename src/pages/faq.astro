---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FaqSection from '../components/FaqSection.astro';
import { faqPageJsonLd, seoFaqs } from '../data/faqs';

const trackerFaqs = [
  {
    question: 'What does Owned vs Mastered mean on this Fortnite Sprite Tracker?',
    answer:
      '<p>Owned means you extracted that exact sprite and variant. Mastered is a separate mark for taking a sprite to level 5 (and extracting when required). The checklist records both so you can chase completion and mastery separately.</p>',
  },
  {
    question: 'Does this Fortnite Sprite Tracker website need an account?',
    answer:
      '<p>No. Progress is stored in your browser (localStorage). Use Export JSON or a share link to move progress. There is no Epic login and no cloud sync in v1.</p>',
  },
  {
    question: 'Can I print the Fortnite Sprite Tracker checklist?',
    answer:
      '<p>Filter to Missing, then use your browser print dialog for a printable sheet. You can also copy a share link instead of sending a locker screenshot.</p>',
  },
];

const allFaqs = [...seoFaqs, ...trackerFaqs];
---

<Layout
  title="Fortnite Sprite Tracker FAQ — How Sprites Work, Rarity & Safety"
  description="FAQ: What is the point of Sprites in Fortnite, how they work, where to find them, rarity, best and hardest Sprites, Batman archive, and whether this Fortnite Sprite Tracker is safe."
  canonicalPath="/faq"
  jsonLd={faqPageJsonLd(allFaqs)}
>
  <Header slot="header" />
  <FaqSection
    items={allFaqs}
    heading="FAQ"
    eyebrow="Help"
    intro="Sprites, this tracker, rarity, and related Fortnite questions — with JSON-LD FAQPage markup for search."
  />
  <section class="border-t border-hairline bg-canvas-soft">
    <div class="mx-auto max-w-[800px] px-4 py-12 md:px-6">
      <p class="text-sm text-body">
        Ready to check something off? <a href="/#tracker">Open the Fortnite Sprite Tracker checklist</a>
        or browse the <a href="/sprites">Sprite list</a>.
      </p>
    </div>
  </section>
  <Footer slot="footer" />
</Layout>
