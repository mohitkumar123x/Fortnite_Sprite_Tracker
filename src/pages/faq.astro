---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FaqSection from '../components/FaqSection.astro';
import { faqPageJsonLd, getAllFaqs } from '../data/faqs';
import { localeFromPath, localizedPath, t } from '../lib/i18n';

const locale = localeFromPath(Astro.url.pathname);
const lp = (href: string) => localizedPath(locale, href);
const allFaqs = getAllFaqs(locale);
---

<Layout
  title={t(locale, 'pageFaqTitle')}
  description={t(locale, 'pageFaqDesc')}
  canonicalPath={lp('/faq')}
  jsonLd={faqPageJsonLd(allFaqs)}
>
  <Header slot="header" />
  <FaqSection
    items={allFaqs}
    heading={t(locale, 'faqPageHeading')}
    eyebrow={t(locale, 'faqPageEyebrow')}
    intro={t(locale, 'faqPageIntro')}
  />
  <section class="border-t border-hairline bg-canvas-soft">
    <div class="mx-auto max-w-[800px] px-4 py-12 md:px-6">
      <p class="text-sm text-body">
        {t(locale, 'faqReady')} <a href={lp('/#tracker')}>{t(locale, 'faqOpenChecklist')}</a>
        {' '}{t(locale, 'faqOrBrowse')}{' '}
        <a href={lp('/sprites')}>{t(locale, 'spriteList')}</a>.
      </p>
    </div>
  </section>
  <Footer slot="footer" />
</Layout>
