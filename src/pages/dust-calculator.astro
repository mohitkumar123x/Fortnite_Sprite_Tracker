---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { allSprites } from '../lib/catalog';
import { localeFromPath, localizedPath, t } from '../lib/i18n';
import { SITE_URL } from '../lib/seo';

const locale = localeFromPath(Astro.url.pathname);
const lp = (href: string) => localizedPath(locale, href);
const site = Astro.site ?? new URL(SITE_URL);

const title = t(locale, 'dustCalcPageTitle');
const description = t(locale, 'dustCalcPageDesc');

const spritesForCalc = allSprites.map((s) => ({
  id: s.id,
  name: s.name,
  rarity: s.rarity,
  variants: s.variants.map((v) => ({
    id: v.id,
    label: v.label,
    dustCost: v.dustCost ?? null,
  })),
}));

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'ItemPage',
    name: title,
    description,
    url: `${site.origin}${lp('/dust-calculator')}`,
  },
];
---

<Layout title={title} description={description} canonicalPath={lp('/dust-calculator')} jsonLd={jsonLd}>
  <Header slot="header" />
  <div class="mx-auto max-w-[840px] px-4 md:px-6 pt-4">
    <Breadcrumb locale={locale} items={[{ label: t(locale, 'bcDustCalc') }]} />
  </div>

  <style is:inline>
    /* ── Floating dust canvas ──────────────────────────────── */
    #dust-canvas {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      pointer-events: none;
      z-index: 0;
    }

    /* ── Scroll-reveal fade-up ─────────────────────────────── */
    @keyframes dust-fade-up {
      from { opacity: 0; transform: translateY(16px); }
      to   { opacity: 1; transform: translateY(0); }
    }
    .dust-reveal { opacity: 0; animation: dust-fade-up .5s ease-out forwards; }
    .dust-reveal-d1 { animation-delay: .08s; }
    .dust-reveal-d2 { animation-delay: .16s; }
    .dust-reveal-d3 { animation-delay: .24s; }
    .dust-reveal-d4 { animation-delay: .32s; }

    /* ── Result value pulse on update ──────────────────────── */
    @keyframes dust-pop {
      0%   { transform: scale(1); }
      35%  { transform: scale(1.12); }
      100% { transform: scale(1); }
    }
    .dust-pop { animation: dust-pop .35s ease-out; }

    /* ── Affordance message shimmer ────────────────────────── */
    @keyframes dust-shimmer {
      0%   { opacity: .85; }
      50%  { opacity: 1; }
      100% { opacity: .85; }
    }
    .dust-shimmer { animation: dust-shimmer 1.8s ease-in-out infinite; }

    /* ── Table row stagger fade-in ─────────────────────────── */
    @keyframes dust-row-in {
      from { opacity: 0; transform: translateX(-8px); }
      to   { opacity: 1; transform: translateX(0); }
    }
    .dust-row { opacity: 0; animation: dust-row-in .4s ease-out forwards; }
    .dust-row:nth-child(1) { animation-delay: .1s; }
    .dust-row:nth-child(2) { animation-delay: .18s; }
    .dust-row:nth-child(3) { animation-delay: .26s; }
    .dust-row:nth-child(4) { animation-delay: .34s; }

    /* ── How-to card hover glow ────────────────────────────── */
    .dust-how-card {
      transition: transform .2s ease, box-shadow .2s ease;
    }
    .dust-how-card:hover {
      transform: translateY(-2px);
      box-shadow: 0 4px 12px rgba(0,0,0,.06);
    }
  </style>

  <section class="relative min-h-screen border-b border-hairline bg-canvas/95 py-8 md:py-14 overflow-hidden" data-dust-root>
    <canvas id="dust-canvas" aria-hidden="true"></canvas>
    <div class="relative z-10 mx-auto max-w-[840px] px-4 md:px-6">

      <!-- Header Row -->
      <div class="flex items-center justify-between gap-4 dust-reveal">
        <div class="flex items-center gap-3">
          <a
            href={lp('/')}
            class="inline-flex size-10 items-center justify-center rounded-full border border-hairline bg-canvas-soft text-ink transition-colors hover:bg-canvas-soft-2"
            aria-label={t(locale, 'backToTracker')}
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="19" y1="12" x2="5" y2="12"></line>
              <polyline points="12 19 5 12 12 5"></polyline>
            </svg>
          </a>
          <h1 class="text-2xl font-bold tracking-tight text-ink md:text-3xl">{t(locale, 'dustCalcPageTitle')}</h1>
        </div>

        <button
          type="button"
          data-print-btn
          class="inline-flex size-10 items-center justify-center rounded-full border border-hairline bg-canvas-soft text-ink transition-colors hover:bg-canvas-soft-2"
          title={t(locale, 'printPage')}
          aria-label={t(locale, 'printPage')}
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="6 9 6 2 18 2 18 9"></polyline>
            <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path>
            <rect x="6" y="14" width="12" height="8"></rect>
          </svg>
        </button>
      </div>

      <!-- Subtitle -->
      <p class="mt-4 text-sm md:text-base leading-relaxed text-body dust-reveal dust-reveal-d1">
        {t(locale, 'dustCalcIntro')}
      </p>

      <!-- Calculator Card -->
      <div class="mt-8 rounded-xl border border-hairline bg-canvas p-6 shadow-card dust-reveal dust-reveal-d2">
        <p class="text-caption-mono text-mute">{t(locale, 'dustCalcEyebrow')}</p>
        <h2 class="mt-2 text-lg font-bold text-ink">{t(locale, 'dustCalcTitle')}</h2>

        <!-- Form -->
        <div class="mt-6 grid gap-4 sm:grid-cols-2">
          <!-- Sprite selector -->
          <div>
            <label for="dust-sprite" class="mb-1 block text-xs font-semibold uppercase tracking-wider text-mute">{t(locale, 'dustCalcSprite')}</label>
            <select
              id="dust-sprite"
              data-dust-sprite
              class="h-10 w-full rounded-md border border-hairline-strong bg-canvas px-3 text-sm text-ink outline-none focus:border-ink transition-colors"
            >
              {spritesForCalc.map((s) => (
                <option value={s.id} data-rarity={s.rarity}>{s.name}</option>
              ))}
            </select>
          </div>

          <!-- Variant selector -->
          <div>
            <label for="dust-variant" class="mb-1 block text-xs font-semibold uppercase tracking-wider text-mute">{t(locale, 'dustCalcVariant')}</label>
            <select
              id="dust-variant"
              data-dust-variant
              class="h-10 w-full rounded-md border border-hairline-strong bg-canvas px-3 text-sm text-ink outline-none focus:border-ink transition-colors"
            >
            </select>
          </div>

          <!-- Quantity -->
          <div>
            <label for="dust-qty" class="mb-1 block text-xs font-semibold uppercase tracking-wider text-mute">{t(locale, 'dustCalcQuantity')}</label>
            <input
              id="dust-qty"
              type="number"
              min="1"
              max="999"
              value="1"
              data-dust-qty
              class="h-10 w-full rounded-md border border-hairline-strong bg-canvas px-3 text-sm text-ink outline-none focus:border-ink transition-colors"
            />
          </div>

          <!-- Balance -->
          <div>
            <label for="dust-balance" class="mb-1 block text-xs font-semibold uppercase tracking-wider text-mute">{t(locale, 'dustCalcBalance')}</label>
            <input
              id="dust-balance"
              type="number"
              min="0"
              max="999999"
              value="0"
              data-dust-balance
              class="h-10 w-full rounded-md border border-hairline-strong bg-canvas px-3 text-sm text-ink outline-none focus:border-ink transition-colors"
            />
          </div>
        </div>

        <!-- Results -->
        <div class="mt-6 grid gap-3 sm:grid-cols-3" data-dust-results>
          <div class="dust-result-card rounded-lg border border-hairline bg-canvas-soft p-4 text-center transition-all">
            <p class="text-xs font-semibold uppercase tracking-wider text-mute">{t(locale, 'dustCalcCostPer')}</p>
            <p class="mt-1 text-2xl font-bold text-ink" data-dust-cost-per>0</p>
          </div>
          <div class="dust-result-card rounded-lg border border-hairline bg-canvas-soft p-4 text-center transition-all">
            <p class="text-xs font-semibold uppercase tracking-wider text-mute">{t(locale, 'dustCalcTotalCost')}</p>
            <p class="mt-1 text-2xl font-bold text-ink" data-dust-total-cost>0</p>
          </div>
          <div class="dust-result-card rounded-lg border border-hairline bg-canvas-soft p-4 text-center transition-all">
            <p class="text-xs font-semibold uppercase tracking-wider text-mute">{t(locale, 'dustCalcRemaining')}</p>
            <p class="mt-1 text-2xl font-bold text-ink" data-dust-remaining>0</p>
          </div>
        </div>

        <p class="mt-4 text-center text-sm text-body" data-dust-afford-msg></p>
      </div>

      <!-- Cost Table -->
      <div class="mt-10 dust-reveal dust-reveal-d3">
        <h2 class="text-lg font-bold text-ink">{t(locale, 'dustCalcCostTableTitle')}</h2>
        <p class="mt-2 text-sm text-body">{t(locale, 'dustCalcCostTableDesc')}</p>
        <div class="mt-4 overflow-x-auto">
          <table class="w-full text-sm">
            <thead>
              <tr class="border-b border-hairline text-left">
                <th class="py-2 pr-4 font-semibold text-ink">{t(locale, 'dustCalcRarityLabel')}</th>
                <th class="py-2 pr-4 font-semibold text-ink">{t(locale, 'dustCalcNormal')}</th>
                <th class="py-2 font-semibold text-ink">{t(locale, 'dustCalcSpecial')}</th>
              </tr>
            </thead>
            <tbody class="text-body">
              <tr class="dust-row border-b border-hairline/50 hover:bg-canvas-soft/60 transition-colors">
                <td class="py-2.5 pr-4">Rare</td>
                <td class="py-2.5 pr-4 font-mono">100</td>
                <td class="py-2.5 font-mono">2,700</td>
              </tr>
              <tr class="dust-row border-b border-hairline/50 hover:bg-canvas-soft/60 transition-colors">
                <td class="py-2.5 pr-4">Epic</td>
                <td class="py-2.5 pr-4 font-mono">2,700</td>
                <td class="py-2.5 font-mono">4,000</td>
              </tr>
              <tr class="dust-row border-b border-hairline/50 hover:bg-canvas-soft/60 transition-colors">
                <td class="py-2.5 pr-4">Legendary</td>
                <td class="py-2.5 pr-4 font-mono">4,500</td>
                <td class="py-2.5 font-mono">6,750</td>
              </tr>
              <tr class="dust-row hover:bg-canvas-soft/60 transition-colors">
                <td class="py-2.5 pr-4">Mythic</td>
                <td class="py-2.5 pr-4 font-mono">6,750</td>
                <td class="py-2.5 font-mono">10,000</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- How To Section -->
      <div class="mt-12 dust-reveal dust-reveal-d4">
        <h2 class="text-lg font-bold text-ink">{t(locale, 'dustCalcHowTitle')}</h2>
        <div class="mt-4 grid gap-6 sm:grid-cols-2">
          <div class="dust-how-card rounded-lg border border-hairline bg-canvas p-4">
            <h3 class="text-sm font-semibold text-ink">{t(locale, 'dustCalcHowExtract')}</h3>
            <p class="mt-1 text-sm text-body">{t(locale, 'dustCalcHowExtractBody')}</p>
          </div>
          <div class="dust-how-card rounded-lg border border-hairline bg-canvas p-4">
            <h3 class="text-sm font-semibold text-ink">{t(locale, 'dustCalcHowGummy')}</h3>
            <p class="mt-1 text-sm text-body">{t(locale, 'dustCalcHowGummyBody')}</p>
          </div>
          <div class="dust-how-card rounded-lg border border-hairline bg-canvas p-4">
            <h3 class="text-sm font-semibold text-ink">{t(locale, 'dustCalcHowBudget')}</h3>
            <p class="mt-1 text-sm text-body">{t(locale, 'dustCalcHowBudgetBody')}</p>
          </div>
          <div class="dust-how-card rounded-lg border border-hairline bg-canvas p-4">
            <h3 class="text-sm font-semibold text-ink">{t(locale, 'dustCalcHowEvents')}</h3>
            <p class="mt-1 text-sm text-body">{t(locale, 'dustCalcHowEventsBody')}</p>
          </div>
        </div>
      </div>

      <!-- Disclaimer -->
      <p class="mt-8 text-xs text-mute">{t(locale, 'dustCalcDisclaimer')}</p>
    </div>
  </section>

  <Footer slot="footer" />
</Layout>

<script is:inline define:vars={{ spritesJson: JSON.stringify(spritesForCalc) }}>
  (function () {
    const sprites = JSON.parse(spritesJson);
    const root = document.querySelector('[data-dust-root]');
    if (!root) return;

    const spriteSelect = root.querySelector('[data-dust-sprite]');
    const variantSelect = root.querySelector('[data-dust-variant]');
    const qtyInput = root.querySelector('[data-dust-qty]');
    const balanceInput = root.querySelector('[data-dust-balance]');
    const costPerEl = root.querySelector('[data-dust-cost-per]');
    const totalCostEl = root.querySelector('[data-dust-total-cost]');
    const remainingEl = root.querySelector('[data-dust-remaining]');
    const affordMsg = root.querySelector('[data-dust-afford-msg]');
    const resultCards = root.querySelectorAll('.dust-result-card');

    // Rarity-based cost tiers
    const NORMAL_COST = { rare: 100, epic: 2700, legendary: 4500, mythic: 6750 };
    const SPECIAL_COST = { rare: 2700, epic: 4000, legendary: 6750, mythic: 10000 };
    const SPECIAL_VARIANTS = ['gold', 'gummy', 'galaxy', 'holofoil', 'gem', 'cube', 'quack', 'strider', 'dream', 'punk', 'boss', 'seven', 'grim-reaper', 'burnt-peanut', 'pollo', 'vini-jr'];

    function populateVariants() {
      const spriteId = spriteSelect.value;
      const sprite = sprites.find(function (s) { return s.id === spriteId; });
      if (!sprite) return;

      variantSelect.innerHTML = '';
      sprite.variants.forEach(function (v) {
        var opt = document.createElement('option');
        opt.value = v.id;
        opt.textContent = v.label;
        if (v.dustCost != null) opt.setAttribute('data-cost', String(v.dustCost));
        variantSelect.appendChild(opt);
      });
    }

    function popValue(el, value) {
      el.textContent = value;
      el.classList.remove('dust-pop');
      void el.offsetWidth;
      el.classList.add('dust-pop');
    }

    function calculate() {
      var spriteId = spriteSelect.value;
      var variantId = variantSelect.value;
      var qty = Math.max(1, parseInt(qtyInput.value, 10) || 1);
      var balance = Math.max(0, parseInt(balanceInput.value, 10) || 0);

      var sprite = sprites.find(function (s) { return s.id === spriteId; });
      if (!sprite) return;

      var variant = sprite.variants.find(function (v) { return v.id === variantId; });

      var costPer = 0;
      if (variant && variant.dustCost != null) {
        costPer = variant.dustCost;
      } else {
        if (variantId === 'normal') {
          costPer = NORMAL_COST[sprite.rarity] || 100;
        } else {
          costPer = SPECIAL_COST[sprite.rarity] || 2700;
        }
      }

      var totalCost = costPer * qty;
      var remaining = balance - totalCost;
      var affordCount = costPer > 0 ? Math.floor(balance / costPer) : 0;

      popValue(costPerEl, costPer.toLocaleString());
      popValue(totalCostEl, totalCost.toLocaleString());
      popValue(remainingEl, remaining.toLocaleString());

      if (remaining < 0) {
        remainingEl.classList.add('text-error');
        remainingEl.classList.remove('text-ink');
      } else {
        remainingEl.classList.remove('text-error');
        remainingEl.classList.add('text-ink');
      }

      if (balance <= 0) {
        affordMsg.textContent = '';
        affordMsg.classList.remove('dust-shimmer');
      } else {
        affordMsg.textContent = 'Your balance can fund ' + affordCount + ' summon' + (affordCount !== 1 ? 's' : '') + ' at this cost.';
        affordMsg.classList.add('dust-shimmer');
      }
    }

    function onCalculate() {
      resultCards.forEach(function (card) {
        card.classList.remove('dust-pop');
        void card.offsetWidth;
        card.classList.add('dust-pop');
      });
      calculate();
    }

    spriteSelect.addEventListener('change', function () {
      populateVariants();
      onCalculate();
    });
    variantSelect.addEventListener('change', onCalculate);
    qtyInput.addEventListener('input', onCalculate);
    balanceInput.addEventListener('input', onCalculate);

    populateVariants();
    calculate();
  })();
</script>

<script is:inline>
  document.querySelectorAll('[data-print-btn]').forEach(function (btn) {
    btn.addEventListener('click', function () { window.print(); });
  });
</script>

<script is:inline>
  (function () {
    var canvas = document.getElementById('dust-canvas');
    if (!canvas) return;
    var ctx = canvas.getContext('2d');
    var section = canvas.parentElement;
    var particles = [];
    var PARTICLE_COUNT = 35;
    var animId;

    function resize() {
      canvas.width = section.offsetWidth;
      canvas.height = section.offsetHeight;
    }
    resize();
    window.addEventListener('resize', resize);

    var COLORS = [
      'rgba(180,160,120,',
      'rgba(200,180,140,',
      'rgba(160,140,100,',
      'rgba(220,200,160,',
      'rgba(190,170,130,',
      'rgba(210,190,150,',
    ];

    function Particle() {
      this.reset(true);
    }

    Particle.prototype.reset = function (init) {
      this.x = Math.random() * canvas.width;
      this.y = init ? Math.random() * canvas.height : canvas.height + 10;
      this.size = Math.random() * 3 + 1;
      this.speedX = (Math.random() - 0.5) * 0.4;
      this.speedY = -(Math.random() * 0.6 + 0.15);
      this.opacity = Math.random() * 0.5 + 0.15;
      this.fadeDir = Math.random() > 0.5 ? 1 : -1;
      this.fadeSpeed = Math.random() * 0.003 + 0.001;
      this.wobbleAmp = Math.random() * 20 + 5;
      this.wobbleSpeed = Math.random() * 0.02 + 0.005;
      this.wobbleOffset = Math.random() * Math.PI * 2;
      this.t = Math.random() * 200;
      this.color = COLORS[Math.floor(Math.random() * COLORS.length)];
    };

    Particle.prototype.update = function () {
      this.t++;
      this.x += this.speedX + Math.sin(this.t * this.wobbleSpeed + this.wobbleOffset) * 0.3;
      this.y += this.speedY;
      this.opacity += this.fadeDir * this.fadeSpeed;
      if (this.opacity >= 0.65) { this.opacity = 0.65; this.fadeDir = -1; }
      if (this.opacity <= 0.08) { this.opacity = 0.08; this.fadeDir = 1; }
      if (this.y < -10 || this.x < -20 || this.x > canvas.width + 20) {
        this.reset(false);
      }
    };

    Particle.prototype.draw = function () {
      ctx.beginPath();
      ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2);
      ctx.fillStyle = this.color + this.opacity + ')';
      ctx.fill();
    };

    for (var i = 0; i < PARTICLE_COUNT; i++) {
      particles.push(new Particle());
    }

    function loop() {
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      for (var i = 0; i < particles.length; i++) {
        particles[i].update();
        particles[i].draw();
      }
      animId = requestAnimationFrame(loop);
    }
    loop();

    document.addEventListener('visibilitychange', function () {
      if (document.hidden) {
        cancelAnimationFrame(animId);
      } else {
        loop();
      }
    });
  })();
</script>
