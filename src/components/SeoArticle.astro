---
import { getSeoArticle } from '../data/seoArticle';
import { localeFromPath, localizedPath } from '../lib/i18n';

const locale = localeFromPath(Astro.url.pathname);
const lp = (href: string) => localizedPath(locale, href);
const article = getSeoArticle(locale);

type Part = { text: string; href?: string; label?: string };

function linkify(text: string): Part[] {
  const parts: Part[] = [];
  const re = /\[\[([^\]|]+)\|([^\]]+)\]\]/g;
  let last = 0;
  let match: RegExpExecArray | null;
  while ((match = re.exec(text)) !== null) {
    if (match.index > last) parts.push({ text: text.slice(last, match.index) });
    parts.push({ text: match[2], href: match[1], label: match[2] });
    last = match.index + match[0].length;
  }
  if (last < text.length) parts.push({ text: text.slice(last) });
  return parts;
}

function linkHref(href: string) {
  return href.startsWith('#') ? href : lp(href);
}
---

<article
  class="border-t border-hairline bg-canvas-soft"
  id="about"
  itemscope
  itemtype="https://schema.org/Article"
>
  <div class="mx-auto max-w-[800px] px-4 py-20 md:px-6 md:py-28">
    <p class="text-caption-mono text-mute">{article.eyebrow}</p>
    <h2 class="mt-3 text-display-lg text-ink" itemprop="headline">
      {article.headline}
    </h2>
    <p class="mt-2 text-sm text-mute">
      <time datetime={article.updatedIso} itemprop="datePublished">{article.updatedLabel}</time>
      · fortnitespritetracking.com
    </p>

    <div class="mt-8 space-y-6 text-base leading-7 text-body" itemprop="articleBody">
      {
        article.blocks.map((block) => {
          if (block.type === 'h3') {
            return <h3 class="text-display-sm text-ink">{block.text}</h3>;
          }
          if (block.type === 'ol') {
            return (
              <ol class="list-decimal space-y-2 pl-5">
                {block.items.map((item) => (
                  <li>
                    {linkify(item).map((part) =>
                      part.href ? (
                        <a href={linkHref(part.href)}>{part.label}</a>
                      ) : (
                        part.text
                      ),
                    )}
                  </li>
                ))}
              </ol>
            );
          }
          return (
            <p>
              {linkify(block.text).map((part) =>
                part.href ? <a href={linkHref(part.href)}>{part.label}</a> : part.text,
              )}
            </p>
          );
        })
      }
    </div>
  </div>
</article>
