---
import { spriteArtSrc, spriteGlow, spriteMotionDelay } from '../lib/spriteArt';

interface Props {
  id: string;
  name: string;
  variant?: string;
  rarity?: string;
  class?: string;
  size?: 'sm' | 'md' | 'lg';
}

const { id, name, variant, rarity, class: className = '', size = 'md' } = Astro.props;

const sizeClass = size === 'sm' ? 'size-11' : size === 'lg' ? 'size-16' : size === 'md' ? 'size-12' : 'size-12';

const variantLabel = variant && variant !== 'normal' ? variant.charAt(0).toUpperCase() + variant.slice(1) : 'Normal';
const rarityLabel = rarity ? rarity.charAt(0).toUpperCase() + rarity.slice(1) : '';
const altText = rarityLabel
  ? `${name} Sprite icon, ${rarityLabel}, ${variantLabel} — Fortnite Chapter 7 Season 4`
  : `${name} Sprite icon — Fortnite Chapter 7 Season 4`;
---

<span
  class:list={['sprite-art-wrap shrink-0', sizeClass]}
  style={`--sprite-glow: ${spriteGlow(id)}; --sprite-delay: ${spriteMotionDelay(id)}`}
>
  <img
    src={spriteArtSrc(id, variant)}
    alt={altText}
    width="128"
    height="128"
    class:list={['sprite-art rounded-md object-cover', sizeClass, className]}
    loading="lazy"
    decoding="async"
    data-sprite-id={id}
    data-sprite-name={name}
  />
</span>
