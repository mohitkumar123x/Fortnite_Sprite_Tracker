---
import Logo from './Logo.astro';

const year = new Date().getFullYear();
---

<footer class="border-t border-hairline bg-canvas">
  <div class="mx-auto grid max-w-[1400px] gap-10 px-4 py-16 md:grid-cols-4 md:px-6">
    <div class="md:col-span-2">
      <a href="/" class="inline-flex items-center gap-2 text-ink no-underline hover:text-ink">
        <span class="flex size-8 shrink-0 overflow-hidden rounded-md" aria-hidden="true">
          <Logo />
        </span>
        <span class="text-sm font-medium">Fortnite Sprite Tracker</span>
      </a>
      <p class="mt-2 max-w-md text-sm text-body">
        Free online Fortnite Sprite Tracker checklist — track Owned and Mastered, Hunt Mode, share my collection, and season archives including Batman.
      </p>
      <p class="mt-4 text-caption-mono text-mute">fortnitespritetracking.com</p>
    </div>
    <div>
      <p class="text-caption-mono text-mute">Product</p>
      <ul class="mt-3 space-y-2 text-sm text-body">
        <li><a href="/#tracker" class="text-body no-underline hover:text-ink">Tracker checklist</a></li>
        <li><a href="/#about" class="text-body no-underline hover:text-ink">About / SEO guide</a></li>
        <li><a href="/seasons" class="text-body no-underline hover:text-ink">Seasons</a></li>
        <li><a href="/sprites" class="text-body no-underline hover:text-ink">Sprite list</a></li>
        <li><a href="/compare" class="text-body no-underline hover:text-ink">Compare</a></li>
        <li><a href="/#faq" class="text-body no-underline hover:text-ink">FAQ</a></li>
      </ul>
    </div>
    <div>
      <p class="text-caption-mono text-mute">Legal</p>
      <ul class="mt-3 space-y-2 text-sm text-body">
        <li><a href="/about" class="text-body no-underline hover:text-ink">About us</a></li>
        <li><a href="/privacy" class="text-body no-underline hover:text-ink">Privacy policy</a></li>
        <li><a href="/terms" class="text-body no-underline hover:text-ink">Terms &amp; conditions</a></li>
        <li><a href="/contact" class="text-body no-underline hover:text-ink">Contact us</a></li>
      </ul>
      <p class="mt-4 text-sm text-body">
        Progress stays in your browser. No account. Share codes only contain checklist bits you choose to copy.
      </p>
    </div>
  </div>
  <div class="border-t border-hairline">
    <div class="mx-auto flex max-w-[1400px] flex-col gap-3 px-4 py-6 text-xs text-mute md:flex-row md:items-center md:justify-between md:px-6">
      <p>© {year} Fortnite Sprite Tracker. Unofficial fan project. Not affiliated with Epic Games, Inc.</p>
      <p class="flex flex-wrap gap-x-4 gap-y-1">
        <a href="/privacy" class="text-mute no-underline hover:text-ink">Privacy</a>
        <a href="/terms" class="text-mute no-underline hover:text-ink">Terms</a>
        <a href="/contact" class="text-mute no-underline hover:text-ink">Contact</a>
      </p>
    </div>
  </div>
</footer>
