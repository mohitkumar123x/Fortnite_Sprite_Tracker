---
import Logo from './Logo.astro';
import { localeFromPath, localizedPath, t } from '../lib/i18n';

const year = new Date().getFullYear();
const locale = localeFromPath(Astro.url.pathname);
const lp = (href: string) => localizedPath(locale, href);
---

<footer class="border-t border-hairline bg-canvas">
  <div class="mx-auto grid max-w-[1400px] gap-10 px-4 py-16 md:grid-cols-4 md:px-6">
    <div class="md:col-span-2">
      <a href={lp('/')} class="inline-flex items-center gap-2 text-ink no-underline hover:text-ink">
        <span class="flex size-8 shrink-0 overflow-hidden rounded-md" aria-hidden="true">
          <Logo />
        </span>
        <span class="text-sm font-medium">Fortnite Sprite Tracker</span>
      </a>
      <p class="mt-2 max-w-md text-sm text-body">
        {t(locale, 'footerBlurb')}
      </p>
      <p class="mt-4 text-caption-mono text-mute">fortnitespritetracking.com</p>
    </div>
    <div>
      <p class="text-caption-mono text-mute">{t(locale, 'product')}</p>
      <ul class="mt-3 space-y-2 text-sm text-body">
        <li><a href={lp('/#tracker')} class="text-body no-underline hover:text-ink">{t(locale, 'trackerChecklist')}</a></li>
        <li><a href={lp('/#about')} class="text-body no-underline hover:text-ink">{t(locale, 'aboutGuide')}</a></li>
        <li><a href={lp('/seasons')} class="text-body no-underline hover:text-ink">{t(locale, 'navSeasons')}</a></li>
        <li><a href={lp('/sprites')} class="text-body no-underline hover:text-ink">{t(locale, 'spriteList')}</a></li>
        <li><a href={lp('/compare')} class="text-body no-underline hover:text-ink">{t(locale, 'navCompare')}</a></li>
        <li><a href={lp('/#faq')} class="text-body no-underline hover:text-ink">{t(locale, 'navFaq')}</a></li>
        <li><a href={lp('/blog')} class="text-body no-underline hover:text-ink">{t(locale, 'navBlog')}</a></li>
        <li><a href={lp('/dust-calculator')} class="text-body no-underline hover:text-ink">{t(locale, 'navDustCalc')}</a></li>
      </ul>
    </div>
    <div>
      <p class="text-caption-mono text-mute">{t(locale, 'legal')}</p>
      <ul class="mt-3 space-y-2 text-sm text-body">
        <li><a href={lp('/about')} class="text-body no-underline hover:text-ink">{t(locale, 'aboutUs')}</a></li>
        <li><a href={lp('/privacy')} class="text-body no-underline hover:text-ink">{t(locale, 'privacyPolicy')}</a></li>
        <li><a href={lp('/terms')} class="text-body no-underline hover:text-ink">{t(locale, 'terms')}</a></li>
        <li><a href={lp('/contact')} class="text-body no-underline hover:text-ink">{t(locale, 'contactUs')}</a></li>
      </ul>
      <p class="mt-4 text-sm text-body">
        {t(locale, 'footerLocal')}
      </p>
    </div>
  </div>
  <div class="border-t border-hairline">
    <div class="mx-auto flex max-w-[1400px] flex-col gap-3 px-4 py-6 text-xs text-mute md:flex-row md:items-center md:justify-between md:px-6">
      <p>{t(locale, 'copyright', { year })}</p>
      <p class="flex flex-wrap gap-x-4 gap-y-1">
        <a href={lp('/privacy')} class="text-mute no-underline hover:text-ink">{t(locale, 'privacy')}</a>
        <a href={lp('/terms')} class="text-mute no-underline hover:text-ink">{t(locale, 'terms')}</a>
        <a href={lp('/contact')} class="text-mute no-underline hover:text-ink">{t(locale, 'contact')}</a>
      </p>
    </div>
  </div>
</footer>
