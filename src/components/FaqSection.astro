---
import { getSeoFaqs, type FaqItem } from '../data/faqs';
import { localeFromPath, t } from '../lib/i18n';

interface Props {
  items?: FaqItem[];
  heading?: string;
  eyebrow?: string;
  intro?: string;
}

const locale = localeFromPath(Astro.url.pathname);
const {
  items = getSeoFaqs(locale),
  heading = t(locale, 'faqHeading'),
  eyebrow = t(locale, 'faqEyebrow'),
  intro = t(locale, 'faqIntro'),
} = Astro.props;

function answerPlain(html: string) {
  return html.replace(/<\/?p>/g, '').replace(/<[^>]+>/g, '');
}
---

<section id="faq" class="border-t border-hairline bg-canvas" aria-labelledby="faq-heading">
  <div class="mx-auto max-w-[800px] px-4 py-20 md:px-6 md:py-28">
    <p class="text-caption-mono text-mute">{eyebrow}</p>
    <h2 id="faq-heading" class="mt-3 text-display-lg text-ink">{heading}</h2>
    <p class="mt-3 text-lg text-body">{intro}</p>
    <div class="mt-12 space-y-3">
      {
        items.map((item) => (
          <details class="group rounded-md border border-hairline bg-canvas-soft p-5 open:shadow-card">
            <summary class="cursor-pointer list-none text-display-sm text-ink marker:content-none [&::-webkit-details-marker]:hidden">
              <span class="flex items-start justify-between gap-4">
                <span>{item.question}</span>
                <span class="shrink-0 text-mute transition group-open:rotate-45" aria-hidden="true">
                  +
                </span>
              </span>
            </summary>
            <p class="mt-3 text-sm leading-6 text-body">{answerPlain(item.answer)}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>
