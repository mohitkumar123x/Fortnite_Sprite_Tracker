---
import SpriteArt from './SpriteArt.astro';
import { localeFromPath, t } from '../lib/i18n';
import { localizeRarity, localizeSpriteAbility } from '../lib/localizeData';
import type { Rarity } from '../lib/types';

interface Props {
  id: string;
  name: string;
  rarity: string;
  seasonLabel: string;
  variantCount: number;
  ability: string;
  href: string;
}

const { id, name, rarity, seasonLabel, variantCount, ability, href } = Astro.props;
const locale = localeFromPath(Astro.url.pathname);
const localizedRarity = localizeRarity(rarity as Rarity, locale);
const localizedAbility = localizeSpriteAbility(id, ability, locale);
---

<a
  href={href}
  class="group block rounded-md border border-hairline bg-canvas p-5 shadow-card no-underline transition-transform hover:-translate-y-0.5 hover:text-ink"
>
  <div class="flex items-start gap-4">
    <SpriteArt id={id} name={name} />
    <div>
      <h3 class="text-display-sm text-ink group-hover:text-ink">{name}</h3>
      <p class="mt-1 text-sm text-body">
        <span class="capitalize">{localizedRarity}</span>
        <span class="mx-1 text-mute">·</span>
        {seasonLabel}
      </p>
      <p class="mt-2 text-sm leading-5 text-body line-clamp-2">{localizedAbility}</p>
      <p class="mt-2 text-xs text-mute">{t(locale, 'variantsCount', { n: variantCount })}</p>
    </div>
  </div>
</a>
