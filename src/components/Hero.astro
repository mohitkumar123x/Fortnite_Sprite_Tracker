---
import { localeFromPath, localizedPath, t } from '../lib/i18n';

const locale = localeFromPath(Astro.url.pathname);
---

<section class="relative overflow-hidden border-b border-hairline bg-canvas">
  <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
    <div class="mesh-gradient absolute -inset-[25%] opacity-90 dark:opacity-80 animate-[mesh-drift_18s_ease-in-out_infinite_alternate]"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-canvas from-10% via-canvas/55 to-transparent dark:from-canvas dark:from-0% dark:via-canvas/40 dark:to-transparent"></div>
    <div class="absolute inset-0 bg-gradient-to-b from-transparent via-transparent to-canvas-soft"></div>
  </div>

  <div class="relative mx-auto max-w-[1400px] px-4 pb-20 pt-16 md:px-6 md:pb-28 md:pt-24">
    <h1 class="max-w-3xl text-display-xl text-ink max-md:text-[36px] max-md:leading-[40px] max-md:tracking-[-1.6px]">
      {t(locale, 'heroTitle')}
    </h1>
    <p class="mt-5 max-w-xl text-lg leading-7 text-body">
      {t(locale, 'heroBody')}
    </p>
    <div class="mt-8 flex flex-wrap items-center gap-3">
      <a
        href="#tracker"
        class="inline-flex h-12 items-center rounded-pill bg-ink px-4 text-base font-medium text-on-primary no-underline transition-transform hover:scale-[1.02] hover:text-on-primary"
      >
        {t(locale, 'openTracker')}
      </a>
      <a
        href={localizedPath(locale, '/sprites')}
        class="inline-flex h-12 items-center rounded-pill border border-hairline-strong bg-canvas px-4 text-base font-medium text-ink no-underline hover:bg-canvas-soft hover:text-ink"
      >
        {t(locale, 'browseSprites')}
      </a>
    </div>
  </div>
</section>
