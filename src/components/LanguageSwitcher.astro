---
import { LOCALES, localeFromPath, localeMeta, switchLocalePath, t } from '../lib/i18n';
import FlagIcon from './FlagIcon.astro';

const pathname = Astro.url.pathname;
const locale = localeFromPath(pathname);
---

<div class="relative" data-lang-switcher>
  <button
    type="button"
    class="inline-flex h-9 items-center gap-2 rounded-sm border border-hairline-strong bg-canvas px-2.5 text-sm font-medium text-ink transition-colors hover:bg-canvas-soft-2"
    aria-haspopup="listbox"
    aria-expanded="false"
    aria-label={t(locale, 'language')}
    data-lang-trigger
  >
    <FlagIcon locale={locale} class="w-4.5 h-3" />
    <span class="uppercase tracking-wide text-xs font-semibold">{locale}</span>
    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="shrink-0 opacity-50 transition-transform" data-lang-chevron>
      <polyline points="6 9 12 15 18 9"></polyline>
    </svg>
  </button>

  <ul
    class="absolute right-0 top-full z-50 mt-1.5 hidden min-w-[160px] overflow-hidden rounded-md border border-hairline bg-canvas py-1 shadow-card-md"
    role="listbox"
    aria-label={t(locale, 'language')}
    data-lang-menu
  >
    {
      LOCALES.map((code) => (
        <li role="option" aria-selected={code === locale ? 'true' : 'false'}>
          <a
            href={switchLocalePath(pathname, code)}
            hreflang={localeMeta[code].htmlLang}
            lang={localeMeta[code].htmlLang}
            class:list={[
              'flex items-center gap-2.5 px-3 py-2 text-sm no-underline transition-colors',
              code === locale
                ? 'bg-canvas-soft-2 font-medium text-ink'
                : 'text-body hover:bg-canvas-soft hover:text-ink',
            ]}
          >
            <FlagIcon locale={code} class="w-5 h-3.5" />
            <span>{localeMeta[code].label}</span>
            {code === locale && (
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="ml-auto shrink-0 text-link" aria-hidden="true">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
            )}
          </a>
        </li>
      ))
    }
  </ul>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-lang-switcher]').forEach((switcher) => {
    const trigger = switcher.querySelector<HTMLButtonElement>('[data-lang-trigger]');
    const menu = switcher.querySelector<HTMLElement>('[data-lang-menu]');
    const chevron = switcher.querySelector<HTMLElement>('[data-lang-chevron]');
    if (!trigger || !menu) return;

    function open() {
      menu!.classList.remove('hidden');
      trigger!.setAttribute('aria-expanded', 'true');
      chevron?.classList.add('rotate-180');
    }

    function close() {
      menu!.classList.add('hidden');
      trigger!.setAttribute('aria-expanded', 'false');
      chevron?.classList.remove('rotate-180');
    }

    function toggle() {
      const isOpen = trigger!.getAttribute('aria-expanded') === 'true';
      isOpen ? close() : open();
    }

    trigger.addEventListener('click', (e) => {
      e.stopPropagation();
      toggle();
    });

    // Close on outside click
    document.addEventListener('click', (e) => {
      if (!switcher.contains(e.target as Node)) close();
    });

    // Close on Escape
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') close();
    });

    // Keyboard navigation within the menu
    menu.addEventListener('keydown', (e) => {
      const items = [...menu!.querySelectorAll<HTMLAnchorElement>('a')];
      const idx = items.indexOf(document.activeElement as HTMLAnchorElement);
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        items[(idx + 1) % items.length]?.focus();
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        items[(idx - 1 + items.length) % items.length]?.focus();
      }
    });
  });
</script>
