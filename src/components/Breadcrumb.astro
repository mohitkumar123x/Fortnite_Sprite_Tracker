---
import { t, type Locale, localizedPath } from '../lib/i18n';

export interface Props {
  items: { label: string; href?: string }[];
  locale?: Locale;
}

const { items, locale = 'en' } = Astro.props;
const homeHref = localizedPath(locale, '/');
---

<nav aria-label="Breadcrumb" class="no-print">
  <ol class="flex flex-wrap items-center gap-1 text-xs text-mute">
    <li>
      <a href={homeHref} class="transition-colors hover:text-ink">{t(locale, 'bcHome')}</a>
    </li>
    {items.map((item, i) => (
      <li class="flex items-center gap-1">
        <span class="text-hairline">/</span>
        {item.href ? (
          <a href={item.href} class="transition-colors hover:text-ink">{item.label}</a>
        ) : (
          <span class="text-ink font-medium">{item.label}</span>
        )}
      </li>
    ))}
  </ol>
</nav>
