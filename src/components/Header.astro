---
import ThemeToggle from './ThemeToggle.astro';
import Logo from './Logo.astro';

const pathname = Astro.url.pathname;

const links = [
  { href: '/#tracker', label: 'Tracker' },
  { href: '/seasons', label: 'Seasons' },
  { href: '/sprites', label: 'Sprites' },
  { href: '/compare', label: 'Compare' },
  { href: '/faq', label: 'FAQ' },
];

function isActive(href: string) {
  if (href.startsWith('/#')) return pathname === '/';
  return pathname === href || pathname.startsWith(`${href}/`);
}
---

<header class="sticky top-0 z-40 border-b border-hairline bg-canvas/90 backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-[1400px] items-center justify-between gap-4 px-4 md:px-6">
    <a href="/" class="group flex items-center gap-2 text-ink no-underline hover:text-ink">
      <span class="flex size-8 shrink-0 overflow-hidden rounded-md" aria-hidden="true">
        <Logo />
      </span>
      <span class="text-sm font-medium tracking-tight">Fortnite Sprite Tracker</span>
    </a>

    <nav class="hidden items-center gap-1 md:flex" aria-label="Primary">
      {
        links.map((link) => (
          <a
            href={link.href}
            class:list={[
              'rounded-full px-3 py-2 text-sm no-underline transition-colors',
              isActive(link.href)
                ? 'bg-canvas-soft-2 text-ink'
                : 'text-body hover:bg-canvas-soft-2 hover:text-ink',
            ]}
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <ThemeToggle />
      <a
        href="/#tracker"
        class="inline-flex h-7 items-center rounded-sm bg-ink px-2 text-sm font-medium text-on-primary no-underline hover:bg-ink/90 hover:text-on-primary"
      >
        Open tracker
      </a>
      <button
        type="button"
        id="nav-toggle"
        class="inline-flex size-9 items-center justify-center rounded-full border border-hairline bg-canvas text-ink md:hidden"
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label="Open menu"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-nav" class="hidden border-t border-hairline bg-canvas md:hidden" hidden>
    <nav class="mx-auto flex max-w-[1400px] flex-col gap-1 px-4 py-3" aria-label="Mobile">
      {
        links.map((link) => (
          <a
            href={link.href}
            class="rounded-md px-3 py-2.5 text-sm text-body no-underline hover:bg-canvas-soft-2 hover:text-ink"
            data-mobile-link
          >
            {link.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('nav-toggle');
  const panel = document.getElementById('mobile-nav');
  toggle?.addEventListener('click', () => {
    const open = panel?.hasAttribute('hidden') === false;
    if (!panel || !toggle) return;
    if (open) {
      panel.hidden = true;
      panel.classList.add('hidden');
      toggle.setAttribute('aria-expanded', 'false');
      toggle.setAttribute('aria-label', 'Open menu');
    } else {
      panel.hidden = false;
      panel.classList.remove('hidden');
      toggle.setAttribute('aria-expanded', 'true');
      toggle.setAttribute('aria-label', 'Close menu');
    }
  });
  panel?.querySelectorAll('[data-mobile-link]').forEach((link) => {
    link.addEventListener('click', () => {
      if (!panel || !toggle) return;
      panel.hidden = true;
      panel.classList.add('hidden');
      toggle.setAttribute('aria-expanded', 'false');
    });
  });
</script>
