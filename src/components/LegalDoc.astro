---
import { localeFromPath, localeMeta, t } from '../lib/i18n';

interface Props {
  eyebrow: string;
  heading: string;
  intro: string;
  updated: string;
}

const { eyebrow, heading, intro, updated } = Astro.props;
const locale = localeFromPath(Astro.url.pathname);
const formatted = new Date(`${updated}T12:00:00Z`).toLocaleDateString(localeMeta[locale].dateLocale, {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});
---

<section class="border-b border-hairline bg-canvas">
  <div class="mx-auto max-w-[800px] px-4 py-16 md:px-6 md:py-24">
    <p class="text-caption-mono text-mute">{eyebrow}</p>
    <h1 class="mt-3 text-display-lg text-ink">{heading}</h1>
    <p class="mt-4 text-lg text-body">{intro}</p>
    <p class="mt-2 text-sm text-mute">
      {t(locale, 'lastUpdated')} <time datetime={updated}>{formatted}</time>
    </p>
    {
      locale !== 'en' && (
        <p class="mt-2 text-sm text-mute">{t(locale, 'legalEnglishNote')}</p>
      )
    }
    <div class="legal-doc mt-10 text-base leading-7 text-body">
      <slot />
    </div>
  </div>
</section>

<style>
  .legal-doc :global(h2) {
    margin-top: 2.5rem;
    font-size: 1.25rem;
    line-height: 1.4;
    letter-spacing: -0.02em;
    color: var(--color-ink);
  }
  .legal-doc :global(p) {
    margin-top: 0.75rem;
  }
  .legal-doc :global(ul) {
    margin-top: 0.75rem;
    padding-left: 1.25rem;
    list-style: disc;
  }
  .legal-doc :global(li + li) {
    margin-top: 0.35rem;
  }
  .legal-doc :global(a) {
    text-underline-offset: 3px;
  }
</style>
